prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only git status is safe to run without prompting",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only git diff is safe to run without prompting",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only git log is safe to run without prompting",
)

prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["pnpm", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["yarn", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["php", "artisan", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["vendor/bin/phpunit"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["pytest"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["git", "push", "origin", ["dev", "staging", "HEAD:dev", "HEAD:staging"]],
    decision = "allow",
    justification = "dev and staging are not restricted; agents may push to them directly",
)

prefix_rule(
    pattern = ["git", "push", ["-u", "--set-upstream"], "origin", ["dev", "staging"]],
    decision = "allow",
    justification = "dev and staging are not restricted; agents may push to them directly",
)

prefix_rule(
    pattern = ["git", "push", "origin", ["main", "master", "develop", "trunk", "HEAD:main", "HEAD:master", "HEAD:develop", "HEAD:trunk"]],
    decision = "forbidden",
    justification = "Never push protected branches; ask the user to push them explicitly after review",
)

prefix_rule(
    pattern = ["git", "push", ["-u", "--set-upstream", "-f", "--force", "--force-with-lease"], "origin", ["main", "master", "develop", "trunk"]],
    decision = "forbidden",
    justification = "Never push protected branches; ask the user to push them explicitly after review",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive; ask the user to run it explicitly",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Destructive; ask the user to run it explicitly",
)

prefix_rule(
    pattern = ["fvm", "dart", "format"],
    decision = "allow",
    justification = "Formatting is safe and reversible",
)

prefix_rule(
    pattern = ["ps", "-axo", "pid,ppid,etime,pcpu,comm"],
    decision = "allow",
    justification = "Read-only process listing",
)
