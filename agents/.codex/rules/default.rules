prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only git status is safe to run without prompting",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only git diff is safe to run without prompting",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only git log is safe to run without prompting",
)

prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["pnpm", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["yarn", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["php", "artisan", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["vendor/bin/phpunit"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["pytest"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["git", "push", "origin", ["main", "master", "develop", "trunk", "dev", "staging", "HEAD:main", "HEAD:master", "HEAD:develop", "HEAD:trunk", "HEAD:dev", "HEAD:staging"]],
    decision = "forbidden",
    justification = "Never push protected branches; ask the user to push them explicitly after review",
)

prefix_rule(
    pattern = ["git", "push", ["-u", "--set-upstream", "-f", "--force", "--force-with-lease"], "origin", ["main", "master", "develop", "trunk", "dev", "staging"]],
    decision = "forbidden",
    justification = "Never push protected branches; ask the user to push them explicitly after review",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive; ask the user to run it explicitly",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Destructive; ask the user to run it explicitly",
)

prefix_rule(
    pattern = ["fvm", "dart", "format"],
    decision = "allow",
    justification = "Formatting is safe and reversible",
)

prefix_rule(
    pattern = ["ps", "-axo", "pid,ppid,etime,pcpu,comm"],
    decision = "allow",
    justification = "Read-only process listing",
)
prefix_rule(pattern=["make", "agents-sync"], decision="allow")
prefix_rule(pattern=["make", "verify-agent-workflow"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "fvm flutter test --no-pub --reporter expanded > /tmp/vf-stable-full.log 2>&1"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "fvm flutter test --no-pub --reporter expanded test/service/distributor_invoice/import_layout_regression_test.dart /tmp/vf_assert_pdf_test.dart > /tmp/vf-verified.log 2>&1"], decision="allow")
prefix_rule(pattern=["fvm", "flutter", "devices"], decision="allow")
prefix_rule(pattern=["fvm", "flutter", "run", "-d", "emulator-5554", "--dart-define-from-file=.env"], decision="allow")
prefix_rule(pattern=["git", "switch", "-c"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "amp plugins exec \"$PWD/amp/.config/amp/plugins/workflow-guardrails.ts\" tool.call --data '{\"toolUseID\":\"tool-test\",\"tool\":\"shell_command\",\"input\":{\"command\":\"git status --short\"},\"thread\":{\"id\":\"T-00000000-0000-0000-0000-000000000000\"}}'"], decision="allow")
prefix_rule(pattern=["git", "add", "-A"], decision="allow")
