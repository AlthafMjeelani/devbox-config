prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only git status is safe to run without prompting",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only git diff is safe to run without prompting",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only git log is safe to run without prompting",
)

prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["pnpm", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["yarn", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["php", "artisan", "test"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["vendor/bin/phpunit"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["pytest"],
    decision = "allow",
    justification = "Project test runners are allowed without prompting",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Never push automatically; ask the user to push explicitly after review",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive; ask the user to run it explicitly",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Destructive; ask the user to run it explicitly",
)

prefix_rule(
    pattern = ["fvm", "dart", "format"],
    decision = "allow",
    justification = "Formatting is safe and reversible",
)

prefix_rule(
    pattern = ["ps", "-axo", "pid,ppid,etime,pcpu,comm"],
    decision = "allow",
    justification = "Read-only process listing",
)
