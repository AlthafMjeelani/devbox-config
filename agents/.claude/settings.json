{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm test:*)",
      "Bash(pnpm test:*)",
      "Bash(yarn test:*)",
      "Bash(go test:*)",
      "Bash(pytest:*)",
      "Bash(php artisan test:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(git push origin dev)",
      "Bash(git push -u origin dev)",
      "Bash(git push --set-upstream origin dev)",
      "Bash(git push origin staging)",
      "Bash(git push -u origin staging)",
      "Bash(git push --set-upstream origin staging)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push -u origin main)",
      "Bash(git push -f origin main)",
      "Bash(git push --force origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin master)",
      "Bash(git push -u origin master)",
      "Bash(git push -f origin master)",
      "Bash(git push --force origin master)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push origin develop)",
      "Bash(git push -u origin develop)",
      "Bash(git push -f origin develop)",
      "Bash(git push --force origin develop)",
      "Bash(git push origin HEAD:develop)",
      "Bash(git push origin trunk)",
      "Bash(git push -u origin trunk)",
      "Bash(git push -f origin trunk)",
      "Bash(git push --force origin trunk)",
      "Bash(git push origin HEAD:trunk)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/service-account*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/guard-default-branch claude-hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/guard-default-branch claude-push-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-statusline"
  }
}
