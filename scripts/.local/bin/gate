#!/usr/bin/env bash
#
# gate - our own AI ship-gate. Validates a branch in a disposable worktree, then
# pushes and opens a PR only after the gate passes. Our own take on no-mistakes;
# no external binary, built on `git-wt` + `opencode`/`claude`/`codex`/`kimi`/`amp`/`commandcode`/`antigravity` + `gh`.
#
# Usage:
#   gate init [--engine opencode|claude|codex|kimi|amp|commandcode|antigravity]
#   gate run           Review and verify the current committed task branch locally.
#   gate run --ship    After verification, push the task branch and open a draft PR.
#   gate status        Show the resolved config.
#   gate help
#
# Configure deterministic GATE_TEST and GATE_LINT in a committed .gate.sh.
# Requires git-wt, jq, and gh for --ship.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
AMP_GATE_SETTINGS="${GATE_AMP_SETTINGS:-$SCRIPT_DIR/../share/agentic/amp-settings.json}"
AMP_GUARD_PLUGIN="$HOME/.config/amp/plugins/workflow-guardrails.ts"
COMMANDCODE_GUARD_HOOK="$HOME/.commandcode/hooks/crew-guard.sh"

die() { printf 'gate: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1;34m▸ %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✔ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$*" >&2; }

require_amp_guard() {
	[ -r "$AMP_GUARD_PLUGIN" ] || { warn "Amp workflow guard plugin not found: $AMP_GUARD_PLUGIN"; return 1; }
}

require_commandcode_guard() {
	[ -x "$COMMANDCODE_GUARD_HOOK" ] || { warn "CommandCode crew guard hook not found: $COMMANDCODE_GUARD_HOOK (run: make restow-commandcode)"; return 1; }
}

agent_output_failed() {
	grep -qiE 'auto-rejecting|user rejected permission|permission requested:|^✗ |Error: The user rejected permission' <<< "$1"
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

# --- config -----------------------------------------------------------------

# Defaults; a repo's .gate.sh may override these. Test and lint commands are required.
GATE_TEST=""
GATE_LINT=""
GATE_DOCS=""
GATE_REVIEW_CMD='gate_review_opencode'
GATE_REVIEW_APPROVE=1
GATE_FIX_CMD='opencode run "$GATE_PROMPT" --agent build'   # GATE_PROMPT contains the fix prompt
GATE_EVIDENCE_DIR=".gate/evidence"
GATE_WATCH_CI=0
GATE_PUSH_REMOTE="origin"
GATE_PR_ARGS="--fill"

load_config() {
	local cfg; cfg="$(repo_root)/.gate.sh"
	# shellcheck source=/dev/null
	[ -f "$cfg" ] && source "$cfg"
	case "$GATE_REVIEW_CMD" in
		'opencode run "/gate-review" --agent reviewer'|'opencode run "/gate-review"')
			GATE_REVIEW_CMD='gate_review_opencode'
			;;
	esac
	case "$GATE_FIX_CMD" in
		'opencode run "%s" --agent build')
			GATE_FIX_CMD='opencode run "$GATE_PROMPT" --agent build'
			;;
	esac
	return 0   # a missing .gate.sh must not fail the caller under `set -e`
}

# --- init -------------------------------------------------------------------

cmd_init() {
	local engine="opencode"
	while [ $# -gt 0 ]; do
		case "$1" in
			--engine) shift; engine="${1:-}" ;;
			-*) die "unknown flag: $1" ;;
			*) die "unexpected argument: $1" ;;
		esac
		shift
	done
	local review_cmd fix_cmd
	case "$engine" in
		opencode)
			review_cmd='gate_review_opencode'
			fix_cmd='opencode run "$GATE_PROMPT" --agent build'
			;;
		claude)
			review_cmd='claude -p "/gate-review" --output-format text'
			fix_cmd='claude -p "$GATE_PROMPT" --output-format text'
			;;
		codex)
			review_cmd='codex exec --sandbox read-only "Use the gate-review skill on the current branch diff; output only the JSON"'
			fix_cmd='codex exec --sandbox workspace-write "$GATE_PROMPT"'
			;;
		kimi)
			review_cmd='gate_review_kimi'
			fix_cmd='gate_fix_kimi'
			;;
		amp)
			review_cmd='gate_review_amp'
			fix_cmd='gate_fix_amp'
			;;
		commandcode)
			review_cmd='gate_review_commandcode'
			fix_cmd='gate_fix_commandcode'
			;;
		antigravity|agy)
			review_cmd='gate_review_antigravity'
			fix_cmd='gate_fix_antigravity'
			;;
		*) die "unknown engine: $engine" ;;
	esac
	local cfg; cfg="$(repo_root)/.gate.sh"
	[ -e "$cfg" ] && die ".gate.sh already exists at $cfg"
	cat > "$cfg" <<EOF
# .gate.sh - optional ship-gate overrides (sourced by \`gate\`). Plain bash, not YAML.
# Set test and lint to project commands. Leave docs empty to skip.

GATE_TEST=""
GATE_DOCS=""
GATE_LINT=""

# Examples:
# GATE_TEST="pnpm test"
# GATE_LINT="pnpm lint"
# GATE_DOCS="pnpm docs:check"
# GATE_DOCS="npx markdown-link-check README.md"
# GATE_DOCS='opencode run "check docs cover this diff; update them if not" --agent docs-writer'

# Structured review: the command must output JSON findings (auto_fix vs ask_user).
# auto_fix findings are applied automatically; ask_user findings are gated (below).
GATE_REVIEW_CMD='$review_cmd'
# Alternatives:
# GATE_REVIEW_CMD='gate_review_opencode'
# GATE_REVIEW_CMD='claude -p "/gate-review" --output-format text'
# GATE_REVIEW_CMD='codex exec --sandbox read-only "Use the gate-review skill on the current branch diff; output only the JSON"'
# GATE_REVIEW_CMD='gate_review_kimi'
# GATE_REVIEW_CMD='gate_review_amp'
# GATE_REVIEW_CMD='gate_review_commandcode'

# 1 = ask_user findings need human approval before shipping (prompted interactively;
#     blocked when headless). 0 = informational only, never blocks.
GATE_REVIEW_APPROVE=1

# How auto-fixes are requested. The failing-stage / fix prompt is passed in GATE_PROMPT.
GATE_FIX_CMD='$fix_cmd'
# Alternatives:
# GATE_FIX_CMD='opencode run "\$GATE_PROMPT" --agent build'
# GATE_FIX_CMD='claude -p "\$GATE_PROMPT" --output-format text'
# GATE_FIX_CMD='codex exec --sandbox workspace-write "\$GATE_PROMPT"'
# GATE_FIX_CMD='gate_fix_kimi'
# GATE_FIX_CMD='gate_fix_amp'
# GATE_FIX_CMD='gate_fix_commandcode'

GATE_EVIDENCE_DIR=".gate/evidence"   # review evidence trail (gitignored)
GATE_WATCH_CI=0                      # 1 = watch CI after the draft PR opens
GATE_PUSH_REMOTE="origin"
GATE_PR_ARGS="--fill"                # extra args for \`gh pr create\`
EOF
	ok "wrote $cfg"
	# Keep the evidence trail out of git.
	local gi; gi="$(repo_root)/.gitignore"
	if ! { [ -f "$gi" ] && grep -qxF '.gate/' "$gi"; }; then
		printf '.gate/\n' >> "$gi"
		ok "added .gate/ to .gitignore"
	fi
	printf '  Configure test and lint commands, then commit .gate.sh.\n'
}

# --- run --------------------------------------------------------------------

run_stage() {
	local name="$1" cmd="$2"
	[ -n "$cmd" ] || { info "skip $name (not configured)"; return 0; }
	info "$name: $cmd"
	# Keep stage failures deterministic. Run each check in its own shell context.
	bash -e -o pipefail -c "$cmd" || { warn "$name failed"; return 1; }
	ok "$name passed"
}

# Apply one fix request via GATE_FIX_CMD and commit if it changed anything.
# Args: <commit-message> <fix-prompt>. Echoes the short sha on success (empty if no-op).
run_fix_command() {
	local prompt="$1" cmd
	if [[ "$GATE_FIX_CMD" == *%s* ]]; then
		# Backward compatibility for old .gate.sh commands. Substitute a variable reference,
		# not the raw prompt, so shell metacharacters in findings are never re-parsed.
		# shellcheck disable=SC2059
		cmd=$(printf "$GATE_FIX_CMD" '$GATE_PROMPT')
	else
		cmd="$GATE_FIX_CMD"
	fi
	GATE_PROMPT="$prompt" eval "$cmd"
}

apply_fix() {
	local msg="$1" prompt="$2"
	# Fix output goes to stderr so only the resulting sha lands on stdout for the caller.
	run_fix_command "$prompt" >&2 || return 1
	# git status --porcelain catches new/untracked files too (git diff does not).
	if [ -n "$(git status --porcelain)" ]; then
		git add -A && git commit -q -m "$msg" >&2 || return 1
		git rev-parse --short HEAD
	fi
}

# Structured review + human-approval gate. Runs with cwd = the gate worktree.
# Returns 0 to continue the ship, non-zero to abort it.
gate_review_prompt() {
	local base diff
	base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
	diff=$(git diff "$(git merge-base "$base" HEAD 2>/dev/null || echo "$base")"...HEAD 2>/dev/null | sed -n '1,4000p')
	cat <<EOF
Review this branch's committed changes for the ship gate and output findings as a single JSON object.

Rules:
- Output only JSON - no prose, no markdown fences, nothing before or after.
- Shape: {"findings":[{"id":"F1","severity":"high|medium|low","class":"auto_fix|ask_user","file":"path/to/file","line":0,"summary":"one-line problem","suggested_fix":"concrete instruction"}]}
- If there is nothing to flag, output {"findings":[]}.
- auto_fix means safe, mechanical, and unambiguous.
- ask_user means the finding needs human judgment, including logic, security, performance, architecture, public API, or behavior decisions.
- Be conservative with auto_fix. When in doubt, classify as ask_user.
- suggested_fix must be specific enough to apply directly.

Diff (branch vs its base):
$diff
EOF
}

gate_review_opencode() {
	# Pure mode prevents optional skills from producing permission prompts in headless runs.
	# Review overrides build's model: classifying auto_fix vs ask_user is judgment, not mechanical
	# like the fixes, so it runs a reasoning notch above GATE_FIX_CMD.
	opencode run "$(gate_review_prompt)" --agent reviewer --model openai/gpt-6.1-terra --pure
}

gate_review_kimi() {
	# K3 handles the judgment-heavy review. stream-json keeps thinking and progress off
	# stdout; select the final Assistant message so the gate receives only its JSON payload.
	kimi --model kimi-code/k3 -p "$(gate_review_prompt)" --output-format stream-json 2>/dev/null \
		| jq -sr '[.[] | select(.role == "assistant" and (.content | type == "string")) | .content] | last // ""'
}

gate_review_amp() {
	[ -r "$AMP_GATE_SETTINGS" ] || { warn "Amp safety settings not found: $AMP_GATE_SETTINGS"; return 1; }
	require_amp_guard || return 1
	amp --settings-file "$AMP_GATE_SETTINGS" --no-notifications -m medium \
		--plugin-ready-timeout 10 -x "$(gate_review_prompt)"
}

gate_fix_kimi() {
	# Regular K2.7 is the reliable coding model for bounded mechanical fixes. Kimi print
	# mode uses auto permissions, so reinforce the gate's local-only safety boundary.
	kimi --model kimi-code/kimi-for-coding -p "$GATE_PROMPT

Work only in the current disposable worktree. Do not push, open or modify pull requests,
use sudo, rewrite Git history, delete the worktree, or perform outward-facing actions."
}

gate_fix_amp() {
	[ -r "$AMP_GATE_SETTINGS" ] || { warn "Amp safety settings not found: $AMP_GATE_SETTINGS"; return 1; }
	require_amp_guard || return 1
	amp --settings-file "$AMP_GATE_SETTINGS" --no-notifications -m medium \
		--plugin-ready-timeout 10 -x "$GATE_PROMPT

Work only in the current disposable worktree. Do not push, open or modify pull requests,
use sudo, rewrite Git history, delete the worktree, or perform outward-facing actions."
}

gate_review_commandcode() {
	# Qwen3.7-Max (the deep tier) handles the judgment-heavy review. -p print mode is
	# read-only, so no is needed here; plain-text output is fine - run_review strips
	# fences and extracts the final findings JSON.
	commandcode -p "$(gate_review_prompt)" --model Qwen/Qwen3.7-Max --skip-onboarding -t 2>/dev/null
}

gate_fix_commandcode() {
	require_commandcode_guard || return 1
	CREW_MANAGED=1 commandcode -p "$GATE_PROMPT

Work only in the current disposable worktree. Do not push, open or modify pull requests,
use sudo, rewrite Git history, delete the worktree, or perform outward-facing actions." \
		--model deepseek/deepseek-v4-pro --skip-onboarding -t
}

gate_review_antigravity() {
	local bin="agy"
	command -v agy >/dev/null 2>&1 || bin="antigravity"
	"$bin" -p "$(gate_review_prompt)" --model gemini-3.1-pro-high 2>/dev/null
}

gate_fix_antigravity() {
	local bin="agy"
	command -v agy >/dev/null 2>&1 || bin="antigravity"
	CREW_MANAGED=1 "$bin" -p "$GATE_PROMPT

Work only in the current disposable worktree. Do not push, open or modify pull requests,
use sudo, rewrite Git history, delete the worktree, or perform outward-facing actions." \
		--model gemini-3.8-flash-high
}

run_review() {
	local root="$1" branch="$2"
	[ -n "$GATE_REVIEW_CMD" ] || { info "skip review (not configured)"; return 0; }

	info "review: $GATE_REVIEW_CMD"
	local raw json
	raw=$(eval "$GATE_REVIEW_CMD" 2>&1) || { warn "review command failed"; printf '%s\n' "$raw"; return 1; }
	if agent_output_failed "$raw"; then warn "review reported permission or tool errors"; return 1; fi
	# Strip markdown fences, then fall back to the final JSON findings object.
	# Agent tool logs and source diffs can contain unrelated braces before the result.
	json=$(printf '%s\n' "$raw" | sed -e 's/^```json[[:space:]]*//' -e 's/^```[[:space:]]*//' -e 's/```[[:space:]]*$//')
	if ! printf '%s' "$json" | jq -e '.findings | type == "array" and all(.[]; .class == "auto_fix" or .class == "ask_user")' >/dev/null 2>&1; then
		json=$(printf '%s\n' "$raw" | grep -E '^\{"findings":' | tail -1 || true)
	fi
	if ! printf '%s' "$json" | jq -e '.findings | type == "array" and all(.[]; .class == "auto_fix" or .class == "ask_user")' >/dev/null 2>&1; then
		warn "review did not return parseable JSON - blocking the ship"
		printf '%s\n' "$raw" | tail -40
		return 1
	fi

	local ts ev
	ts=$(date +%Y%m%d-%H%M%S)
	ev="$root/${GATE_EVIDENCE_DIR:-.gate/evidence}/${ts}-$(printf '%s' "$branch" | tr '/:' '__')"
	mkdir -p "$ev"
	printf '%s\n' "$json" | jq '.' > "$ev/review.json" 2>/dev/null || printf '%s\n' "$json" > "$ev/review.json"
	printf '# Gate review - %s (%s)\n\n' "$branch" "$ts" > "$ev/summary.md"

	local n_auto n_ask
	n_auto=$(printf '%s' "$json" | jq '[.findings[]|select(.class=="auto_fix")]|length')
	n_ask=$(printf '%s' "$json" | jq '[.findings[]|select(.class=="ask_user")]|length')
	info "review findings: $n_auto auto-fix, $n_ask ask-user (evidence: ${ev#"$root"/})"

	# --- auto_fix: apply all in one pass ---
	if [ "$n_auto" -gt 0 ]; then
		local fixlist sha
		fixlist=$(printf '%s' "$json" | jq -r '.findings[]|select(.class=="auto_fix")|"- [\(.id)] \(.file):\(.line) \(.summary) -> \(.suggested_fix)"')
		info "applying $n_auto auto-fix finding(s)"
		sha=$(apply_fix "fix(gate): auto-fix review findings" "Apply these safe, mechanical review fixes and nothing else:
$fixlist") || { warn "review fix failed"; return 1; }
		[ -n "$sha" ] && ok "committed review auto-fixes ($sha)" || warn "auto-fix produced no changes"
		printf '## Auto-fixed (commit: %s)\n%s\n\n' "${sha:-none}" "$fixlist" >> "$ev/summary.md"
	fi

	# --- ask_user: approval gate ---
	[ "$n_ask" -gt 0 ] || return 0
	printf '## Ask-user (needs judgment)\n' >> "$ev/summary.md"

	local list
	list=$(printf '%s' "$json" | jq -r '.findings[]|select(.class=="ask_user")|"  [\(.id)] \(.severity) \(.file):\(.line) - \(.summary)"')

	if [ "${GATE_REVIEW_APPROVE:-1}" != "1" ]; then
		warn "$n_ask ask-user finding(s) - informational (GATE_REVIEW_APPROVE=0):"
		printf '%s\n' "$list"
		printf '%s\n' "$list" | sed 's/^ */- /;s/$/ (informational)/' >> "$ev/summary.md"
		return 0
	fi

	if [ ! -t 0 ]; then
		warn "$n_ask ask-user finding(s) need approval, but no TTY (headless) - blocking the ship:"
		printf '%s\n' "$list"
		printf '%s\n' "$list" | sed 's/^ */- /;s/$/ -> BLOCKED (headless)/' >> "$ev/summary.md"
		printf '\nRe-run `gate run` in a terminal to approve.\n' >> "$ev/summary.md"
		return 1
	fi

	# interactive: prompt per finding
	local ids id sev file line summary sfix ans sha
	ids=$(printf '%s' "$json" | jq -r '.findings[]|select(.class=="ask_user")|.id')
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		sev=$(printf '%s' "$json" | jq -r --arg i "$id" '.findings[]|select(.id==$i)|.severity')
		file=$(printf '%s' "$json" | jq -r --arg i "$id" '.findings[]|select(.id==$i)|.file')
		line=$(printf '%s' "$json" | jq -r --arg i "$id" '.findings[]|select(.id==$i)|.line')
		summary=$(printf '%s' "$json" | jq -r --arg i "$id" '.findings[]|select(.id==$i)|.summary')
		sfix=$(printf '%s' "$json" | jq -r --arg i "$id" '.findings[]|select(.id==$i)|.suggested_fix')
		printf '\n\033[1;33mask-user [%s] %s  %s:%s\033[0m\n  %s\n  suggested: %s\n' "$id" "$sev" "$file" "$line" "$summary" "$sfix"
		printf '  [a]pprove & ship / [f]ix now / [b]lock ? '
		read -r ans </dev/tty || ans="b"
		case "$ans" in
			a|A) printf -- '- [%s] %s:%s %s -> APPROVED\n' "$id" "$file" "$line" "$summary" >> "$ev/summary.md" ;;
			f|F)
				sha=$(apply_fix "fix(gate): fix review finding $id" "Apply this review fix and nothing else: [$id] $file:$line - $summary -> $sfix") || { warn "review fix failed"; return 1; }
				if [ -n "$sha" ]; then
					ok "committed fix for $id ($sha)"
					printf -- '- [%s] %s:%s %s -> FIXED (%s)\n' "$id" "$file" "$line" "$summary" "$sha" >> "$ev/summary.md"
				else
					warn "fix produced no changes for $id"
					printf -- '- [%s] %s:%s %s -> FIX NO-OP\n' "$id" "$file" "$line" "$summary" >> "$ev/summary.md"
				fi
				;;
			*)
				warn "blocked on $id - aborting the ship"
				printf -- '- [%s] %s:%s %s -> BLOCKED\n' "$id" "$file" "$line" "$summary" >> "$ev/summary.md"
				return 1
				;;
		esac
	done <<< "$ids"
	return 0
}

cmd_run() {
	local ship=0
	if [ "${1:-}" = --ship ]; then ship=1; shift; fi
	[ "$#" -eq 0 ] || die "usage: gate run [--ship] (check out the task branch first)"

	local root branch head wt gate_branch remote_default
	root=$(repo_root)
	branch=$(git symbolic-ref --quiet --short HEAD) || die "check out a task branch first"
	"$SCRIPT_DIR/guard-default-branch" check-branch "$branch" || die "protected branch: $branch"
	case "$branch" in agent/*|gate/*) die "run Gate from the integration branch" ;; esac
	[ "${CREW_MANAGED:-}" != 1 ] || die "only the orchestrator can run Gate"
	[ -z "$(git status --porcelain)" ] || die "commit or stash changes first"
	git -C "$root" ls-files --error-unmatch -- .gate.sh >/dev/null 2>&1 || die "commit .gate.sh first"
	load_config
	[ -n "${GATE_TEST//[[:space:]]/}" ] && [ -n "${GATE_LINT//[[:space:]]/}" ] \
		|| die "GATE_TEST and GATE_LINT must be configured in .gate.sh"
	command -v git-wt >/dev/null 2>&1 || die "git-wt not on PATH"
	command -v jq >/dev/null 2>&1 || die "jq not on PATH"
	if [ "$ship" -eq 1 ]; then
		command -v gh >/dev/null 2>&1 || die "gh not on PATH"
		git remote get-url "$GATE_PUSH_REMOTE" >/dev/null || die "configure the publishing remote"
		remote_default=$(git symbolic-ref -q "refs/remotes/$GATE_PUSH_REMOTE/HEAD" || true)
		[ "$remote_default" != "refs/remotes/$GATE_PUSH_REMOTE/$branch" ] || die "cannot publish to the remote default branch"
	fi

	head=$(git rev-parse HEAD)
	gate_branch="gate/$branch"
	git -C "$root" show-ref --verify --quiet "refs/heads/$gate_branch" \
		&& die "previous gate branch exists: inspect $gate_branch before retrying"
	git -C "$root" wt new "$gate_branch" "$head" --no-setup >/dev/null
	wt=$(git -C "$root" wt path "$gate_branch")

	local rc=0 validated
	(
		cd "$wt"
		export CREW_MANAGED=1
		run_review "$root" "$branch" || exit 1
		local fail=0
		run_stage test "$GATE_TEST" || fail=1
		run_stage docs "$GATE_DOCS" || fail=1
		run_stage lint "$GATE_LINT" || fail=1
		exit "$fail"
	) || rc=$?
	if [ "$rc" -ne 0 ]; then
		die "verification blocked; worktree retained at $wt"
	fi
	[ -z "$(git -C "$wt" status --porcelain)" ] || die "verification left uncommitted files in $wt"
	[ "$(git -C "$root" symbolic-ref -q HEAD)" = "refs/heads/$branch" ] \
		&& [ "$(git -C "$root" rev-parse HEAD)" = "$head" ] \
		&& [ -z "$(git -C "$root" status --porcelain)" ] || die "integration branch changed; worktree retained at $wt"
	validated=$(git -C "$wt" rev-parse HEAD)
	if [ "$validated" != "$head" ]; then
		die "review produced commits in $wt; integrate them and rerun Gate before publishing"
	fi
	ok "all gates passed"
	git -C "$root" wt rm "$gate_branch" -D >/dev/null
	[ "$ship" -eq 1 ] || return 0

	git -C "$root" push -- "$GATE_PUSH_REMOTE" "$validated:refs/heads/$branch"
	local pr_url
	if pr_url=$(cd "$root" && gh pr view "$branch" --json url --jq .url 2>/dev/null); then
		ok "PR already exists: $pr_url"
	else
		# GATE_PR_ARGS is an existing space-delimited configuration value.
		local -a pr_args
		read -r -a pr_args <<< "$GATE_PR_ARGS"
		(cd "$root" && gh pr create "${pr_args[@]}" --head "$branch" --draft)
	fi
	if [ "$GATE_WATCH_CI" = 1 ]; then
		(cd "$root" && gh pr checks "$branch" --watch --fail-fast)
	fi
}

cmd_status() {
	load_config
	printf 'repo:            %s\n' "$(repo_root)"
	printf 'config:          %s\n' "$([ -f "$(repo_root)/.gate.sh" ] && echo "$(repo_root)/.gate.sh" || echo '(optional - no .gate.sh)')"
	printf 'GATE_TEST:       %s\n' "${GATE_TEST:-<required>}"
	printf 'GATE_DOCS:       %s\n' "${GATE_DOCS:-<skip>}"
	printf 'GATE_LINT:       %s\n' "${GATE_LINT:-<required>}"
	printf 'GATE_REVIEW:     %s\n' "${GATE_REVIEW_CMD:-<skip>}"
	printf 'GATE_REVIEW_APPROVE: %s\n' "$GATE_REVIEW_APPROVE"
	printf 'GATE_FIX_CMD:    %s\n' "$GATE_FIX_CMD"
	printf 'GATE_EVIDENCE_DIR: %s\n' "$GATE_EVIDENCE_DIR"
	printf 'GATE_WATCH_CI:   %s\n' "$GATE_WATCH_CI"
	printf 'GATE_PUSH_REMOTE: %s\n' "$GATE_PUSH_REMOTE"
}

cmd_help() { awk 'NR==1{next} /^#/{sub(/^#[ ]?/,""); print; next} {exit}' "$0"; }

main() {
	local sub="${1:-help}"; shift || true
	case "$sub" in
		init)           cmd_init "$@" ;;
		run)            cmd_run "$@" ;;
		status)         cmd_status "$@" ;;
		help|-h|--help) cmd_help ;;
		*) die "unknown command: $sub (try: gate help)" ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
