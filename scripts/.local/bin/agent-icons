#!/usr/bin/env bash
# agent-icons - install colored icons for the SwiftBar AI usage dropdown (macOS).
#   agent-icons set <agent> <file.png|file.icns|App.app>   convert and install an icon
#   agent-icons list                                       show which agents have an icon
#   agent-icons remove <agent>                             go back to the built-in glyph
set -euo pipefail
DIR="${AGENT_ICONS_DIR:-$HOME/.config/swiftbar/icons}"
AGENTS="codex claude amp antigravity kimi commandcode opencode"
usage() { sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
valid() { for a in $AGENTS; do [ "$a" = "$1" ] && return 0; done; echo "Unknown agent '$1'. Choose: $AGENTS" >&2; exit 2; }
cmd="${1:-}"; shift || true
case "$cmd" in
  set)
    [ $# -eq 2 ] || usage 2
    agent="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; src="$2"; valid "$agent"
    command -v sips >/dev/null || { echo "sips not found (this helper is for macOS). Copy a PNG to $DIR/$agent.png instead." >&2; exit 1; }
    if [ -d "$src" ] && [[ "$src" == *.app ]]; then
      name="$(defaults read "$src/Contents/Info" CFBundleIconFile 2>/dev/null || true)"
      case "$name" in *.icns) ;; "") ;; *) name="$name.icns" ;; esac
      icon="$src/Contents/Resources/$name"
      [ -n "$name" ] && [ -f "$icon" ] || icon="$(find "$src/Contents/Resources" -maxdepth 1 -name '*.icns' | head -1)"
      [ -f "$icon" ] || { echo "No icon found inside $src" >&2; exit 1; }
      src="$icon"
    fi
    [ -f "$src" ] || { echo "File not found: $src" >&2; exit 1; }
    mkdir -p "$DIR"
    sips -s format png -Z 64 "$src" --out "$DIR/$agent.png" >/dev/null
    echo "Installed $DIR/$agent.png - refresh SwiftBar to see it."
    ;;
  list)
    for a in $AGENTS; do [ -f "$DIR/$a.png" ] && echo "✓ $a" || echo "· $a (built-in glyph)"; done
    ;;
  remove)
    [ $# -eq 1 ] || usage 2
    agent="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; valid "$agent"
    if [ -f "$DIR/$agent.png" ]; then mv "$DIR/$agent.png" "$DIR/$agent.png.removed"; echo "Moved to $agent.png.removed"; else echo "No icon set for $agent"; fi
    ;;
  -h|--help|help|"") usage 0 ;;
  *) usage 2 ;;
esac
