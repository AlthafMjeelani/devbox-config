{
  "amp.gauge": "cost",
  "amp.remoteThreadCreation.enabled": true,
  "amp.permissions": [
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push origin dev"
      },
      "action": "allow"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push -u origin dev"
      },
      "action": "allow"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push origin staging"
      },
      "action": "allow"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push -u origin staging"
      },
      "action": "allow"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* main"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* main *"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push*:main*"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* master"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* master *"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push*:master*"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* develop"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* develop *"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push*:develop*"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* trunk"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push* trunk *"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push*:trunk*"
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git push*"
      },
      "action": "ask"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git reset --hard*"
      },
      "action": "ask"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git clean*"
      },
      "action": "ask"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "rm -rf*"
      },
      "action": "ask"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git status*"
      },
      "action": "allow"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git diff*"
      },
      "action": "allow"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": "git log*"
      },
      "action": "allow"
    }
  ],
  "amp.git.commit.coauthor.enabled": false,
  "amp.git.commit.ampThread.enabled": true,
  "amp.notifications.enabled": true,
  "amp.thread.autoArchiveOnQuit": false
}
