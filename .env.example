# devbox-config environment variables (all optional - every one has a default).
# Copy to .env, uncomment what you need, then load it in your shell profile:
#   set -a; source ~/devbox-config/.env; set +a
# .env is git-ignored; this file (.env.example) is the tracked template. Never put real secrets in this file.

# --- crew (multi-agent orchestrator) ---
# Force the backend for new crewmates: tmux or herdr (default: auto-detect)
#CREW_BACKEND=tmux
# Print timeout for headless Antigravity crewmates
#CREW_AGY_PRINT_TIMEOUT=4h
# Flags passed to headless Codex crewmates
#CREW_CODEX_FLAGS=--sandbox workspace-write

# --- git-wt (worktrees) ---
# Engine and timeout (seconds) used to name branches with AI
#WT_AI_ENGINE=opencode
#WT_AI_TIMEOUT=60

# --- accounts and sync ---
# Where ai-account keeps Claude/Codex login profiles
#AI_ACCOUNT_HOME=$HOME/.local/share/ai-accounts
# Local checkouts for amp-global-sync (Amp personal skills/plugins repositories)
#AMP_GLOBAL_SKILLS_DIR=$HOME/dev/amp-skills
#AMP_GLOBAL_PLUGINS_DIR=$HOME/dev/amp-plugins

# --- Rex terminal ---
# Path to the rex binary if it is not on PATH
#REX_BIN=/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex

# --- menu bar ---
# Where agent-icons keeps the colored agent icons
#AGENT_ICONS_DIR=$HOME/.config/swiftbar/icons

# --- branch guard ---
# Allow commits/edits on main for one command only (prefer: git config devbox.allowDefaultBranch true)
#ALLOW_DEFAULT_BRANCH=1
